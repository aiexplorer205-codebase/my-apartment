# OPTIONAL: keep state in a PRIVATE Cloudflare R2 bucket instead of local disk.
# Rename to backend.tf, then: export AWS_ACCESS_KEY_ID=<R2 key>  AWS_SECRET_ACCESS_KEY=<R2 secret>
# Needs Terraform >= 1.6. Flag names differ between versions, check the S3 backend docs.
# State contains your Tailscale key (marked sensitive but stored), so keep the bucket private.
terraform {
  backend "s3" {
    bucket = "myapartment-tfstate"
    key    = "oracle/terraform.tfstate"
    region = "auto"

    endpoints = {
      s3 = "https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"
    }

    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
    use_path_style              = true
  }
}
