#!/usr/bin/env bash
# Runs once at first boot. Creates /opt/myapartment/.env with generated DB password
# and the queue choice. You add the app secrets afterwards (see README).
set -euo pipefail
cd /opt/myapartment
[ -f .env ] && exit 0

PW=$(openssl rand -hex 24)
umask 077
cat > .env <<ENVEOF
PGUSER=myapartment
PGPASSWORD=$PW
PGDATABASE=myapartment
DATABASE_URL=postgres://myapartment:$PW@db:5432/myapartment
QUEUE_BACKEND=${queue_backend}
COMPOSE_PROFILES=${compose_profiles}
${extra_env}
IMAGE_TAG=latest
AGE_PUBLIC_KEY=${age_public_key}
# ---- add your app secrets below ----
# APP_BASE_URL=https://app.yourdomain.com
# AUTH0_DOMAIN=auth.yourdomain.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# RESEND_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# TUNNEL_TOKEN=
ENVEOF
chmod 600 .env
