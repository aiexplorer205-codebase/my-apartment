{
  "name": "my-apartment",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "config:validate": "node packages/app-platform/scripts/validate-config.ts",
    "i18n:validate": "node packages/app-platform/scripts/validate-translations.ts",
    "branding:validate": "node packages/app-platform/scripts/validate-assets.ts",
    "platform:validate": "node packages/app-platform/scripts/validate-all.ts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "node scripts/run-vitest.mjs",
    "build": "turbo run build",
    "ci": "pnpm run platform:validate && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.11.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.17.0",
    "prisma": "^5.22.0",
    "tslib": "^2.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vite": "6.4.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.23"
    }
  }
}
