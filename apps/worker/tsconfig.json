{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@block9/domain": ["../../packages/domain/src/index.ts"],
      "@block9/shared": ["../../packages/shared/src/index.ts"],
      "@block9/config": ["../../packages/config/src/index.ts"],
      "@block9/application": ["../../packages/application/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/domain/src/**/*.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/config/src/**/*.ts",
    "../../packages/application/src/**/*.ts"
  ]
