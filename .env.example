# Local Compose defaults. Copy to .env and replace all Auth0 and service credentials.
NODE_ENV=development
PROXY_PORT=8080
RESIDENT_WEB_PORT=3098
ADMIN_WEB_PORT=3100
OPERATOR_WEB_PORT=3101
API_PORT=4101
WORKER_PORT=4110

POSTGRES_DB=myapartment_platform_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5434
POSTGRES_PLATFORM_URL=postgresql://myapartment_platform:local-platform-password@postgres:5432/myapartment_platform_db
POSTGRES_TENANT_URL=postgresql://myapartment_app:local-app-password@postgres:5432/myapartment_app_db
REDIS_HOST=redis
REDIS_PORT=6381
REDIS_URL=redis://redis:6379

AUTH0_DOMAIN=example.auth0.com
AUTH0_ISSUER=https://example.auth0.com/
AUTH0_AUDIENCE=https://api.myapartment.local
AUTH0_OPERATOR_CLIENT_ID=replace-with-operator-web-client-id
AUTH0_OPERATOR_CLIENT_SECRET=replace-with-operator-web-client-secret
AUTH0_OPERATOR_SECRET=replace-with-unique-32-byte-random-secret

RESIDENT_WEB_PUBLIC_URL=http://localhost:3098
ADMIN_WEB_PUBLIC_URL=http://localhost:3100
OPERATOR_WEB_PUBLIC_URL=http://localhost:3101
OPERATOR_WEB_PRIVATE_INGRESS=true

OPERATOR_IDS=
OPERATOR_ID=replace-with-approved-auth0-subject
CORS_ORIGINS=http://localhost:3098,http://localhost:3100,http://localhost:3101
AUTH0_OTP_ENABLED=false
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM=no-reply@block9.co.in
FILEBASE_ENDPOINT=https://example.filebase.com
FILEBASE_BUCKET=block9-local-dev
FILEBASE_REGION=us-east-1
FILEBASE_ACCESS_KEY=replace-with-filebase-access-key
FILEBASE_SECRET_KEY=replace-with-filebase-secret-key
FIREBASE_PROJECT_ID=replace-me
FIREBASE_CLIENT_EMAIL=service-account@replace-with-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME
-----END PRIVATE KEY-----
"
QUEUE_RETRY_LIMIT=3

# Local examples only; use independent random passwords and protected secrets in production.
APP_DATABASE_PASSWORD=local-app-password
LIFECYCLE_DATABASE_PASSWORD=local-lifecycle-password
POSTGRES_MAINTENANCE_URL=postgresql://myapartment_operator_lifecycle:local-lifecycle-password@postgres:5432/myapartment_app_db
PLATFORM_DATABASE_PASSWORD=local-platform-password

# Private images: R2 uses region auto and its account S3 endpoint. AWS S3 may
# omit endpoint and use workload IAM credentials instead of static keys.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PROVIDER=r2
PHOTO_RETENTION_DAYS=90
# Deployment-only bucket CORS configuration; never put storage secrets in NEXT_PUBLIC_*.
S3_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Resident authentication is Better Auth only. Never expose these as NEXT_PUBLIC_*.
RESIDENT_AUTH_INTERNAL_URL=http://resident-auth:4120
# Generate a random shared secret; used only for resident-auth -> API session-cache eviction.
RESIDENT_AUTH_CACHE_INVALIDATION_SECRET=
# Generate with: openssl rand -hex 32
AUTH_DATABASE_PASSWORD=local-auth-password
POSTGRES_AUTH_URL=postgresql://myapartment_resident_auth:local-auth-password@postgres:5432/myapartment_platform_db
# Must match your final resident app domain; localhost is for local development only.
RESIDENT_PASSKEY_RP_ID=localhost
AUTH_DATABASE_POOL_SIZE=5

# Public HTTPS object-storage origin (no path) allowed by web CSP; passed at build time.
PHOTO_STORAGE_ORIGIN=
# Enable only for production sites served exclusively through a verified HTTPS edge; rebuild web images.
WEB_HSTS=false

# Isolated admin Better Auth service
ADMIN_AUTH_SECRET=
ADMIN_AUTH_INTERNAL_URL=http://admin-auth:4121
ADMIN_PASSKEY_RP_ID=localhost
ADMIN_AUTH_DATABASE_PASSWORD=local-admin-auth-password
