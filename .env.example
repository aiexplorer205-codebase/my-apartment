# Local development placeholders only. Copy this file to .env and replace values as needed.
NODE_ENV=development
API_PORT=4101
ADMIN_WEB_PORT=3100
OPERATOR_WEB_PORT=3101
WORKER_PORT=4110
POSTGRES_DB=platform_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5434
POSTGRES_PLATFORM_URL=postgresql://postgres:postgres@postgres:5432/platform_db
POSTGRES_TENANT_URL=postgresql://postgres:postgres@postgres:5432/tenant_template
REDIS_HOST=redis
REDIS_PORT=6381
REDIS_URL=redis://redis:6379
AUTH0_DOMAIN=example.auth0.com
AUTH0_ISSUER=https://example.auth0.com/
AUTH0_AUDIENCE=https://api.nivasa.local
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_ADMIN_CLIENT_ID=replace-with-admin-client-id
AUTH0_OPERATOR_CLIENT_ID=replace-with-operator-client-id
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_PASSWORDLESS_CONNECTION=email
AUTH0_REDIRECT_URI=http://localhost:3100
AUTH0_OPERATOR_REDIRECT_URI=http://localhost:3101
AUTH0_OTP_ENABLED=false
# Comma-separated exact Auth0 sub claims approved for operator access.
OPERATOR_IDS=
# Legacy single-operator fallback; use OPERATOR_IDS to approve multiple accounts.
OPERATOR_ID=replace-with-approved-auth0-subject
CORS_ORIGINS=http://localhost:3100,http://localhost:3101
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM=no-reply@local.nivasa.test
FILEBASE_ENDPOINT=https://example.filebase.com
FILEBASE_BUCKET=nivasa-local-dev
FILEBASE_REGION=us-east-1
FILEBASE_ACCESS_KEY=replace-with-filebase-access-key
FILEBASE_SECRET_KEY=replace-with-filebase-secret-key
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=service-account@replace-with-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_ME
-----END PRIVATE KEY-----
"
NEXT_PUBLIC_API_URL=http://localhost:4101
ADMIN_WEB_PUBLIC_URL=http://localhost:3100
OPERATOR_WEB_PUBLIC_URL=http://localhost:3101
QUEUE_RETRY_LIMIT=3
OPERATOR_WEB_PRIVATE_INGRESS=true
