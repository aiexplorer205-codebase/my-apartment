# Copy to .env.production (gitignored). Never store real credentials here.
# Set every image to registry/repository@sha256:<64 hex digits> for one release.
API_IMAGE=
LOGIN_IMAGE=
RESIDENT_IMAGE=
ADMIN_IMAGE=
OPERATOR_IMAGE=
CADDY_IMAGE=
LOGIN_HOST=login.block9.online
RESIDENT_HOST=app.block9.online
ADMIN_HOST=admin.block9.online
OPERATOR_HOST=ops.block9.online
ACME_EMAIL=
POSTGRES_PASSWORD=
# URL-encode the password in both URLs. Internal host/port are postgres:5432.
POSTGRES_PLATFORM_URL=
POSTGRES_TENANT_URL=
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_PASSWORDLESS_CONNECTION=email
AUTH0_RESIDENT_CLIENT_ID=
AUTH0_RESIDENT_CLIENT_SECRET=
AUTH0_RESIDENT_SECRET=
AUTH0_ADMIN_CLIENT_ID=
AUTH0_ADMIN_CLIENT_SECRET=
AUTH0_ADMIN_SECRET=
AUTH0_OPERATOR_CLIENT_ID=
AUTH0_OPERATOR_CLIENT_SECRET=
AUTH0_OPERATOR_SECRET=
OPERATOR_IDS=
OPERATOR_ID=
CORS_ORIGINS=https://app.block9.online,https://admin.block9.online,https://ops.block9.online:8443
RESEND_API_KEY=
RESEND_FROM=
